{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "sh -c 'mkdir -p \"${RAILWAY_VOLUME_MOUNT_PATH:-/app/data}\" && cd \"${RAILWAY_VOLUME_MOUNT_PATH:-/app/data}\" && python /app/otpnewupdate_final_fixed.py'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}